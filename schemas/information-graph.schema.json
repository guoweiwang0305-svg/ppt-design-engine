{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Information Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["graph_id", "thesis", "nodes", "edges"],
  "properties": {
    "graph_id": {"type":"string","minLength":1},
    "thesis": {"type":"string","minLength":1},
    "nodes": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","label"],"properties":{
      "id":{"type":"string"},"label":{"type":"string"},"kind":{"type":"string"},"importance":{"type":"string"},"evidence_ref":{"type":["string","null"]}
    }}},
    "edges": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["source","target","relation"],"properties":{
      "source":{"type":"string"},"target":{"type":"string"},"relation":{"enum":["sequence","hierarchy","comparison","causality","cycle","network","composition","distribution","supports","handoff"]},
      "direction":{"type":"string"},"label":{"type":"string"}
    }}}
  }
}
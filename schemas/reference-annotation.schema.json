{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Reference Annotation",
  "type":"object","additionalProperties":false,
  "required":["reference_id","image_path","information_graph","visual_grammar"],
  "properties":{
    "reference_id":{"type":"string"},"image_path":{"type":"string"},"image_sha256":{"type":["string","null"]},
    "source_description":{"type":"string"},"information_graph":{"type":"object"},
    "visual_grammar":{"type":"object"},"inferred_pattern_ids":{"type":"array","items":{"type":"string"}},
    "analyst_notes":{"type":"array","items":{"type":"string"}},"confidence":{"type":"number","minimum":0,"maximum":1}
  }
}
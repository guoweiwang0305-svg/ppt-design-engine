{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Page Quality Score",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference_id",
    "scores",
    "weighted_total",
    "decision",
    "review_status",
    "evidence"
  ],
  "properties": {
    "reference_id": {
      "type": "string"
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logic",
        "information_value",
        "visual_hierarchy",
        "density_efficiency",
        "chart_or_diagram_quality",
        "reusability",
        "source_traceability"
      ],
      "properties": {
        "logic": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "information_value": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "visual_hierarchy": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "density_efficiency": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "chart_or_diagram_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "reusability": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "source_traceability": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "weighted_total": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "decision": {
      "enum": [
        "recommended",
        "revise",
        "reject"
      ]
    },
    "review_status": {
      "enum": [
        "unreviewed",
        "human_reviewed",
        "approved"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewer_notes": {
      "type": "string"
    }
  }
}

{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"ppt-design-engine/design-ir.schema.json",
  "title":"Design IR",
  "type":"object",
  "additionalProperties":false,
  "required":["deck_id","slide_id","canvas","message","nodes","relations","constraints"],
  "properties":{
    "deck_id":{"type":"string","minLength":1},
    "slide_id":{"type":"string","minLength":1},
    "canvas":{"type":"object","additionalProperties":false,"required":["width","height","unit"],"properties":{
      "width":{"type":"number","exclusiveMinimum":0},"height":{"type":"number","exclusiveMinimum":0},"unit":{"enum":["in","pt","px"]}
    }},
    "message":{"type":"object","additionalProperties":false,"required":["thesis"],"properties":{
      "thesis":{"type":"string","minLength":1},"audience":{"type":"string"},"purpose":{"type":"string"},
      "reading_path":{"type":"array","items":{"type":"string"}}
    }},
    "nodes":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","text","semantic_role"],"properties":{
      "id":{"type":"string","minLength":1},"text":{"type":"string"},
      "semantic_role":{"enum":["thesis","evidence","metric","category","action","context","caveat","label"]},
      "importance":{"enum":["critical","high","medium","low"]},
      "evidence_status":{"enum":["verified","user_supplied","illustrative","unknown"]},
      "reading_order":{"type":"integer"},"source_ref":{"type":["string","null"]},
      "visual_type":{"enum":["text","rect","ellipse"]},"font_size_pt":{"type":"number","exclusiveMinimum":0},
      "color":{"type":"string","pattern":"^#[0-9A-Fa-f]{6}$"},
      "fill":{"type":["string","null"]},"align":{"enum":["left","center","right"]},
      "geometry":{"type":["object","null"],"additionalProperties":false,"required":["x","y","width","height"],"properties":{
        "x":{"type":"number","minimum":0},"y":{"type":"number","minimum":0},
        "width":{"type":"number","exclusiveMinimum":0},"height":{"type":"number","exclusiveMinimum":0}
      }}
    }}},
    "relations":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","from","to","relation_type"],"properties":{
      "id":{"type":"string","minLength":1},"from":{"type":"string","minLength":1},"to":{"type":"string","minLength":1},
      "relation_type":{"enum":["sequence","hierarchy","comparison","causality","cycle","network","composition","distribution","supports","handoff"]},
      "direction":{"enum":["forward","reverse","bidirectional","none"]},"label":{"type":"string"}
    }}},
    "constraints":{"type":"object","additionalProperties":false,"properties":{
      "density":{"enum":["low","medium","high"]},"min_font_pt":{"type":"number","exclusiveMinimum":0},
      "style_dna_ref":{"type":"string"},"allow_gradients":{"type":"boolean"},"allow_shadows":{"type":"boolean"}
    }}
  }
}